# 构建产物
build/
*/build/
manual-build/
out/

# 本地工具链（体积很大，不进仓库）
mc-tool/tools/jdk/
mc-tool/tools/android-sdk/
mc-tool/tools/gradle-dist/
mc-tool/tools/sdk-tmp/
mc-tool/tools/pt/
mc-tool/tools/ptx/
mc-tool/tools/px/
mc-tool/tools/bt/
mc-tool/tools/*.zip
mc-tool/tools/jtmp/
mc-tool/tools/debug.keystore

# 构建/测试临时目录
.gradle/
.gradle-home/
.m2repo/
.robohome/
gtmp/
local.properties

# 签名身份与密钥：本仓库【刻意包含】它们。
# 原因：这把密钥直接来自网易《我的世界》安装包，属【公开性质】——
# 任何人解包游戏 APK 都能提取出来，它不是只有作者知道的秘密。
# 保留在仓库里是为了让别人 clone 下来就能构建出【能覆盖安装】的包。
# ⚠️ 仅供个人自用；不要用它签任何要公开发布的东西。详见 README。
# 想用自己密钥的：删掉下面两行注释即可恢复忽略，再跑 tools/genkey.ps1。
# mc-tool/app/keystore/*.jks
# mc-tool/app/src/main/assets/mc-patch-key.pk8
# mc-tool/app/src/main/assets/mc-patch-cert.pem

# genkey 脚本的临时目录
mc-tool/.genkey-tmp/

# 游戏版权物 / 大文件（这些是你本地的东西，不该进仓库）
*.apk
!dist/*.apk
*.dex
*.so
smali/
*.idsig

# 逆向过程的中间产物
manifest_decoded*/
manifest_dump/
compare_*/
v3_assets/
v4_assets/
tmp_sign*/

# IDE / 系统
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
